---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const researchers = await getCollection('researchers');
  return researchers.map((researcher) => ({
    params: { slug: researcher.id.replace(/\.md$/, '') },
    props: { researcher },
  }));
}

const { researcher } = Astro.props;
const { data } = researcher;
const { Content } = await render(researcher);
---
<BaseLayout pageTitle={data.name}>
  <a href="/personas" class="back">← Volver a Personas</a>
  <article class="profile">
    <h1>👨‍🔬 {data.name}</h1>
    <p class="role">{data.role}</p>
    <p><strong>Áreas de investigación:</strong> {data.areas.join(' • ')}</p>
    {data.email && <p><strong>Contacto:</strong> {data.email}</p>}
    <hr />
    <Content />
  </article>
</BaseLayout>

<style>
  .back { display: inline-block; margin-bottom: 1rem; color: #0284c7; font-weight: 600; text-decoration: none; }
  .profile { background: #fff; border: 1px solid #e2e8f0; padding: 2rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.6rem; }
  .role { color: #0369a1; font-weight: 600; }
  hr { border: 0; border-top: 1px solid #e2e8f0; margin: 0.75rem 0; }
</style>