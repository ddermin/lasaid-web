---
import ContentLayout from '../layouts/ContentLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ResearchLineCard from '../components/ResearchLineCard.astro';
import {
  LAB_PRESENTATION,
  RESEARCH_LINES,
  APPLICATION_AREAS,
  INFRASTRUCTURE_ITEMS,
} from '../data/institutional';
---
<ContentLayout
  pageTitle="Investigación"
  subtitle={LAB_PRESENTATION.researchIntro}
>
  <section class="block">
    <SectionHeader title="Líneas de investigación" />
    <div class="grid-2">
      {RESEARCH_LINES.map((line) => <ResearchLineCard {...line} />)}
    </div>
  </section>

  <section class="block">
    <SectionHeader title="Áreas de aplicación" />
    <div class="tags-container">
      {APPLICATION_AREAS.map((area) => <span class="area-pill">{area}</span>)}
    </div>
  </section>

  <section id="infraestructura" class="block">
    <SectionHeader
      title="Capacidades e infraestructura"
      subtitle="LASAID cuenta con infraestructura para cómputo científico, desarrollo de inteligencia artificial, adquisición experimental de señales y prototipado, utilizada tanto en proyectos de investigación como en formación de estudiantes."
    />
    <div class="grid-2">
      {INFRASTRUCTURE_ITEMS.map((block) => (
        <div class="infra-card">
          <h3>{block.title}</h3>
          <ul>
            {block.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</ContentLayout>

<style>
  .block { margin-bottom: 3rem; }
  .tags-container { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .area-pill {
    background: #ffffff;
    border: 1px solid #bae6fd;
    color: #0369a1;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.55rem 1rem;
    border-radius: 8px;
  }
  .infra-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.5rem;
  }
  .infra-card h3 { font-size: 1.15rem; color: #0f172a; margin-bottom: 0.65rem; }
  .infra-card ul { padding-left: 1.2rem; color: #334155; display: flex; flex-direction: column; gap: 0.35rem; }
</style>
