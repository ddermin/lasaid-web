---
import ContentLayout from '../layouts/ContentLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---
<ContentLayout
  pageTitle="Proyectos de investigación"
  subtitle="Los proyectos desarrollados en LASAID integran investigación científica, formación de estudiantes y desarrollo tecnológico. En ellos pueden participar investigadores y estudiantes y pueden producir tesis, proyectos modulares, publicaciones, conjuntos de datos y herramientas de software."
>
  <div class="grid-2">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</ContentLayout>
