---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const softwareList = await getCollection('software');
  return softwareList.map((sw) => ({
    params: { slug: sw.id.replace(/\.md$/, '') },
    props: { sw },
  }));
}

const { sw } = Astro.props;
const { data } = sw;
const { Content } = await render(sw);
---
<BaseLayout pageTitle={data.name}>
  <a href="/software" class="back">← Volver a Software</a>
  <article class="sw-detail">
    <img src={data.image} alt={data.name} class="banner" />
    <h1>💻 {data.name}</h1>
    <p>{data.description}</p>
    <p>
      <a href={data.website} target="_blank">🌐 Sitio oficial</a> |
      <a href={data.repository} target="_blank">📦 Repositorio Git</a>
    </p>
    <hr />
    <Content />
  </article>
</BaseLayout>

<style>
  .back { display: inline-block; margin-bottom: 1rem; color: #0284c7; font-weight: 600; text-decoration: none; }
  .sw-detail { background: #fff; border: 1px solid #bae6fd; padding: 2rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.75rem; }
  .banner { width: 100%; max-height: 260px; object-fit: cover; border-radius: 8px; }
  hr { border: 0; border-top: 1px solid #e2e8f0; margin: 0.5rem 0; }
  a { color: #0284c7; font-weight: 600; text-decoration: none; }
</style>