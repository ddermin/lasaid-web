---
import ContentLayout from '../../layouts/ContentLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import AcademicWorkCard from '../../components/AcademicWorkCard.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const softwareList = await getCollection('software');
  return softwareList.map((sw) => ({
    params: { slug: sw.data.slug },
    props: { sw },
  }));
}

const { sw } = Astro.props;
const d = sw.data;

const allResearchers = await getCollection('researchers');
const allStudents = await getCollection('students');
const allProjects = await getCollection('projects');
const allPublications = await getCollection('publications');
const allWorks = await getCollection('academic-works');

const studentMap = Object.fromEntries(allStudents.map((s) => [s.data.slug, s.data]));
const projectMap = Object.fromEntries(allProjects.map((p) => [p.data.slug, p.data]));

const relResearchers = allResearchers.filter((r) => d.relatedResearchers.includes(r.data.slug));
const relStudents = allStudents.filter((s) => d.relatedStudents.includes(s.data.slug));
const relProject = d.project ? allProjects.find((p) => p.data.slug === d.project) : null;
const relPub = d.publication ? allPublications.find((p) => p.data.slug === d.publication) : null;
const relWork = d.academicWork ? allWorks.find((w) => w.data.slug === d.academicWork) : null;

const isPending = (v) => !v || String(v).toUpperCase().includes('PENDIENTE');
const validTechs = (d.technologies || []).filter((t) => !isPending(t));
---
<ContentLayout
  pageTitle={d.name}
  subtitle={d.shortDescription}
  backHref="/software"
  backLabel="Volver a Software"
>
  <div class="sw-detail">
    <img src={d.image} alt={`Captura de ${d.name}`} class="banner" />
    <div class="sw-body">
      <span class="status-badge">Estado: {d.status}</span>
      <p class="desc">{d.description}</p>

      {validTechs.length > 0 ? (
        <p><strong>Tecnologías:</strong> {validTechs.join(', ')}</p>
      ) : (
        <Placeholder />
      )}

      {relProject && (
        <p>
          <strong>Proyecto relacionado:</strong>{' '}
          <a href={`/proyectos/${relProject.data.slug}`}>{relProject.data.title}</a>
        </p>
      )}

      {relResearchers.length > 0 && (
        <p>
          <strong>Investigadores:</strong>{' '}
          {relResearchers.map((r, i) => (
            <>
              <a href={`/personas/${r.data.slug}`}>{r.data.name}</a>
              {i < relResearchers.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
      )}

      {relStudents.length > 0 && (
        <p>
          <strong>Estudiantes participantes:</strong>{' '}
          {relStudents.map((s) => s.data.name).join(', ')}
        </p>
      )}

      <div class="links-row">
        {!isPending(d.website) ? (
          <a href={d.website} target="_blank" rel="noopener noreferrer" class="btn">Acceder al sistema ↗</a>
        ) : (
          <Placeholder />
        )}
        {!isPending(d.repository) ? (
          <a href={d.repository} target="_blank" rel="noopener noreferrer" class="btn secondary">Repositorio de código ↗</a>
        ) : (
          <Placeholder />
        )}
      </div>
    </div>
  </div>

  {relWork && (
    <section class="block">
      <SectionHeader title="Trabajo académico vinculado" />
      <AcademicWorkCard work={relWork} studentMap={studentMap} projectMap={projectMap} />
    </section>
  )}

  {relPub && (
    <section class="block">
      <SectionHeader title="Publicación asociada" />
      <PublicationCard publication={relPub} />
    </section>
  )}
</ContentLayout>

<style>
  .sw-detail {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }
  .banner { width: 100%; max-height: 260px; object-fit: cover; border-bottom: 1px solid #e2e8f0; }
  .sw-body { padding: 2rem; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.95rem; }
  .status-badge { align-self: flex-start; background: #dcfce7; color: #166534; font-weight: 700; font-size: 0.78rem; padding: 0.2rem 0.6rem; border-radius: 4px; }
  .desc { font-size: 1rem; color: #1e293b; }
  .sw-body a { color: #0369a1; font-weight: 700; text-decoration: none; }
  .links-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .btn { background: #0284c7; color: #ffffff !important; padding: 0.55rem 1rem; border-radius: 6px; }
  .btn.secondary { background: #f1f5f9; color: #0f172a !important; border: 1px solid #cbd5e1; }
  .block { margin-bottom: 2.5rem; }
</style>
