---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout pageTitle="Contacto">
  <h1>Contacto LASAID</h1>
  <div class="contact-card">
    <p><strong>📍 Ubicación:</strong> Edificio de Investigación, Laboratorio LASAID.</p>
    <p><strong>✉️ Correo institucional:</strong> contacto@lasaid.example.org</p>
    <p><strong>🌐 Repositorio del proyecto:</strong> GitHub - lasaid-web</p>
  </div>
</BaseLayout>

<style>
  .contact-card { background: #fff; border: 1px solid #e2e8f0; padding: 2rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.75rem; }
</style>