---
import BaseLayout from './BaseLayout.astro';

const { pageTitle, subtitle, description, backHref, backLabel } = Astro.props;
---
<BaseLayout pageTitle={pageTitle} description={description || subtitle}>
  <div class="page-header">
    {backHref && <a href={backHref} class="back-link">← {backLabel || "Volver"}</a>}
    <h1>{pageTitle}</h1>
    {subtitle && <p class="lead">{subtitle}</p>}
  </div>
  <slot />
</BaseLayout>

<style>
  .page-header {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2.25rem;
  }
  .back-link {
    display: inline-block;
    color: #0369a1;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }
  .back-link:hover { text-decoration: underline; }
  h1 { font-size: 2rem; color: #0f172a; line-height: 1.25; }
  .lead { color: #334155; font-size: 1.02rem; margin-top: 0.65rem; max-width: 880px; }
  @media (max-width: 640px) {
    .page-header { padding: 1.35rem; }
    h1 { font-size: 1.6rem; }
  }
</style>
