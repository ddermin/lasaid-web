---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  pageTitle = "Inicio",
  description = "Laboratorio de Adquisición de Señales y Análisis Inteligente de Datos (LASAID) — CUCEI, Universidad de Guadalajara."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${pageTitle} | LASAID`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{pageTitle} | LASAID</title>
  </head>
  <body>
    <Header />
    <main class="main-container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { overflow-x: hidden; scroll-behavior: smooth; }
  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #f8fafc;
    color: #0f172a;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overflow-x: hidden;
  }
  .main-container {
    max-width: 1180px;
    width: 100%;
    margin: 0 auto;
    padding: 2.25rem 1.5rem;
    flex: 1;
  }
  .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 992px) {
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 680px) {
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
    .main-container { padding: 1.5rem 1rem; }
  }
</style>
