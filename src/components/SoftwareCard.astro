---
const { software } = Astro.props;
const d = software.data;
const validTechs = (d.technologies || []).filter((t) => !t.toUpperCase().includes('PENDIENTE'));
---
<article class="card">
  <img src={d.image} alt={`Imagen de ${d.name}`} class="thumb" loading="lazy" />
  <div class="body">
    <div class="top-row">
      <h3><a href={`/software/${d.slug}`}>{d.name}</a></h3>
      <span class="status">{d.status}</span>
    </div>
    <p>{d.shortDescription}</p>
    {validTechs.length > 0 && (
      <div class="techs">
        {validTechs.map((t) => <span class="tech-tag">{t}</span>)}
      </div>
    )}
    <a href={`/software/${d.slug}`} class="more-link">Ver ficha técnica y relaciones →</a>
  </div>
</article>

<style>
  .card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .thumb { width: 100%; height: 155px; object-fit: cover; border-bottom: 1px solid #e2e8f0; }
  .body { padding: 1.35rem; display: flex; flex-direction: column; gap: 0.65rem; flex: 1; }
  .top-row { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  h3 { font-size: 1.15rem; margin: 0; }
  h3 a { color: #0f172a; text-decoration: none; }
  h3 a:hover { color: #0284c7; }
  .status { font-size: 0.74rem; background: #dcfce7; color: #166534; padding: 0.15rem 0.5rem; border-radius: 4px; font-weight: 700; }
  p { font-size: 0.92rem; color: #334155; }
  .techs { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .tech-tag { font-size: 0.75rem; background: #f1f5f9; color: #475569; padding: 0.15rem 0.45rem; border-radius: 4px; }
  .more-link { margin-top: auto; padding-top: 0.5rem; color: #0369a1; font-weight: 700; font-size: 0.9rem; text-decoration: none; }
  .more-link:hover { text-decoration: underline; }
</style>
