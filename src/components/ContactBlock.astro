---
import Placeholder from './Placeholder.astro';
const { mapUrl = "PENDIENTE" } = Astro.props;
const validMap = mapUrl && !mapUrl.toUpperCase().includes('PENDIENTE');
---
<div class="contact-grid">
  <div class="contact-info">
    <h3>Laboratorio de Adquisición de Señales y Análisis Inteligente de Datos — LASAID</h3>
    <p class="inst">Centro Universitario de Ciencias Exactas e Ingenierías, Universidad de Guadalajara</p>
    <ul class="details-list">
      <li><strong>Ubicación:</strong> Edificio M, planta alta, oficina 205</li>
      <li><strong>Responsable:</strong> Dr. Israel Román Godínez — <a href="mailto:israel.roman@academicos.udg.mx">israel.roman@academicos.udg.mx</a></li>
      <li><strong>Investigadora:</strong> Dra. Sulema Torres Ramos — <a href="mailto:sulema.torres@academicos.udg.mx">sulema.torres@academicos.udg.mx</a></li>
      <li><strong>Teléfono:</strong> +52 (33) 1378 5900, ext. 27791</li>
    </ul>
  </div>
  <div class="map-box">
    <h4>Ubicación en Campus CUCEI</h4>
    <p>Edificio M, planta alta, oficina 205. Blvd. Gral. Marcelino García Barragán 1421, Olímpica, Guadalajara, Jalisco.</p>
    {validMap ? (
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="map-btn">Ver mapa de ubicación ↗</a>
    ) : (
      <Placeholder />
    )}
  </div>
</div>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.75rem;
  }
  h3 { font-size: 1.18rem; color: #0f172a; margin-bottom: 0.25rem; }
  .inst { color: #0369a1; font-weight: 600; font-size: 0.95rem; margin-bottom: 1rem; }
  .details-list { list-style: none; display: flex; flex-direction: column; gap: 0.55rem; font-size: 0.92rem; color: #334155; }
  .details-list a { color: #0284c7; text-decoration: none; font-weight: 600; }
  .details-list a:hover { text-decoration: underline; }
  .map-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
  }
  h4 { font-size: 1rem; color: #0f172a; }
  .map-box p { font-size: 0.88rem; color: #475569; }
  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
