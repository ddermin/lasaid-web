---
import Placeholder from './Placeholder.astro';

const { activity } = Astro.props;
const d = activity.data;
const isPending = (v) => !v || String(v).toUpperCase().includes('PENDIENTE');

const typeLabels = {
  event: "Evento",
  conference: "Congreso",
  "academic-participation": "Participación académica",
  award: "Reconocimiento",
  presentation: "Presentación",
  outreach: "Divulgación",
  training: "Formación"
};

const validPeople = (d.relatedPeople || []).filter((p) => !isPending(p));
---
<article class="act-card">
  <div class="meta">
    <span class="badge">{typeLabels[d.type] || d.type}</span>
    <span class="date">
      <strong>Fecha:</strong> {!isPending(d.date) ? d.date : <Placeholder/>}
    </span>
  </div>

  <h3>
    {!isPending(d.title) ? d.title : <>Actividad: <Placeholder/></>}
  </h3>

  <p>
    {!isPending(d.description) ? d.description : <><strong>Descripción:</strong> <Placeholder/></>}
  </p>

  <p class="people">
    <strong>Participantes:</strong>{' '}
    {validPeople.length > 0 ? validPeople.join(', ') : <Placeholder/>}
  </p>

  <div class="link-row">
    {!isPending(d.url) ? (
      <a href={d.url} target="_blank" rel="noopener noreferrer" class="link">Ver enlace relacionado →</a>
    ) : (
      <span class="pending-link"><strong>Enlace:</strong> <Placeholder/></span>
    )}
  </div>
</article>

<style>
  .act-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .meta { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem; }
  .badge { background: #e0f2fe; color: #0369a1; font-size: 0.74rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: 4px; }
  .date { font-size: 0.82rem; color: #64748b; }
  h3 { font-size: 1.02rem; color: #0f172a; margin: 0; }
  p { font-size: 0.88rem; color: #334155; }
  .people { font-size: 0.84rem; color: #475569; }
  .link-row { margin-top: auto; font-size: 0.84rem; color: #475569; }
  .link { color: #0369a1; font-weight: 700; font-size: 0.86rem; text-decoration: none; }
</style>
