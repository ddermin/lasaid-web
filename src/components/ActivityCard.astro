---
const { activity } = Astro.props;
const d = activity.data;
const isPending = (v) => !v || String(v).toUpperCase().includes('PENDIENTE');

const typeLabels = {
  event: "Evento",
  conference: "Congreso",
  "academic-participation": "Participación académica",
  award: "Reconocimiento",
  presentation: "Presentación",
  outreach: "Divulgación",
  training: "Formación"
};
---
<article class="act-card">
  <div class="meta">
    <span class="badge">{typeLabels[d.type] || d.type}</span>
    {!isPending(d.date) && <span class="date">{d.date}</span>}
  </div>
  <h3>{d.title}</h3>
  <p>{d.description}</p>
  {d.relatedPeople && d.relatedPeople.length > 0 && (
    <p class="people"><strong>Participantes:</strong> {d.relatedPeople.join(', ')}</p>
  )}
  {!isPending(d.url) && (
    <a href={d.url} target="_blank" rel="noopener noreferrer" class="link">Ver enlace relacionado →</a>
  )}
</article>

<style>
  .act-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .meta { display: flex; justify-content: space-between; align-items: center; }
  .badge { background: #e0f2fe; color: #0369a1; font-size: 0.74rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: 4px; }
  .date { font-size: 0.82rem; color: #64748b; font-weight: 600; }
  h3 { font-size: 1.05rem; color: #0f172a; margin: 0; }
  p { font-size: 0.9rem; color: #334155; }
  .people { font-size: 0.84rem; color: #475569; }
  .link { color: #0369a1; font-weight: 700; font-size: 0.86rem; text-decoration: none; margin-top: auto; }
</style>
