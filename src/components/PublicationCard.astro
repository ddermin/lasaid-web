---
import Placeholder from './Placeholder.astro';

const { publication } = Astro.props;
const d = publication.data;
const isPending = (v) => !v || String(v).toUpperCase().includes('PENDIENTE');
const validVenue = !isPending(d.venue);
const validDoi = !isPending(d.doi);
const validUrl = !isPending(d.url);
const externalHref = validUrl ? d.url : validDoi ? `[https://doi.org/$](https://doi.org/$){d.doi}` : null;
---
<article class="pub-card">
  <div class="pub-meta">
    <span class="year">{d.year}</span>
    {validVenue ? (
      <span class="venue">{d.venue}</span>
    ) : (
      <span class="venue-pending">Revista / Venue: <Placeholder/></span>
    )}
  </div>
  <h3>{d.title}</h3>
  <div class="pub-actions">
    {externalHref ? (
      <a href={externalHref} target="_blank" rel="noopener noreferrer" class="doi-link">
        {validDoi ? `DOI: ${d.doi} ↗` : 'Consultar publicación ↗'}
      </a>
    ) : (
      <span class="doi-pending"><strong>DOI / Enlace:</strong> <Placeholder/></span>
    )}
  </div>
</article>

<style>
  .pub-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .pub-meta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .year {
    background: #0f172a;
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
  }
  .venue { color: #0369a1; font-weight: 700; font-size: 0.88rem; }
  .venue-pending { font-size: 0.84rem; color: #475569; }
  h3 { font-size: 1.05rem; color: #0f172a; line-height: 1.4; margin: 0; }
  .pub-actions { margin-top: 0.25rem; font-size: 0.85rem; color: #475569; }
  .doi-link {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0284c7;
    text-decoration: none;
    word-break: break-all;
  }
  .doi-link:hover { text-decoration: underline; }
</style>
