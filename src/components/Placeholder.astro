---
const MOSTRAR_LEYENDA = true;
const { label = "Información pendiente" } = Astro.props;
---
{MOSTRAR_LEYENDA && (
  <span class="placeholder-badge" title="Dato marcado como PENDIENTE en el Contenido Maestro">
    {label}
  </span>
)}

<style>
  .placeholder-badge {
    display: inline-block;
    background: #f8fafc;
    color: #64748b;
    border: 1px dashed #cbd5e1;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-style: italic;
    line-height: 1.4;
  }
</style>
