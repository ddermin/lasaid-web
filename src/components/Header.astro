---
import Navigation from './Navigation.astro';
---
<header class="site-header">
  <div class="header-container">
    <a href="/" class="brand" aria-label="LASAID — Inicio">
      <span class="brand-acronym">LASAID</span>
      <span class="brand-sub">CUCEI • Universidad de Guadalajara</span>
    </a>
    <Navigation />
  </div>
</header>

<style>
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.85rem 1.5rem;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-container {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .brand-acronym {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .brand-sub {
    font-size: 0.74rem;
    color: #475569;
    font-weight: 600;
  }
</style>
