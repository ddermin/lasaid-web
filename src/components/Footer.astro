---
import { SITE_CONFIG, LAB_LOCATION } from '../data/institutional';
---
<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-col">
      <p class="footer-title">{SITE_CONFIG.siteName} — {SITE_CONFIG.fullName}</p>
      <p class="footer-loc">{LAB_LOCATION.street}</p>
      <p class="footer-loc">{LAB_LOCATION.building} • {LAB_LOCATION.institution}</p>
      <p class="footer-loc">Tel. {LAB_LOCATION.phone}</p>
    </div>
    <div class="footer-links">
      <a href="/investigacion">Investigación</a>
      <a href="/personas">Personas</a>
      <a href="/formacion">Formación</a>
      <a href="/software">Software</a>
      <a href="/proyectos">Proyectos</a>
      <a href="/publicaciones">Publicaciones</a>
      <a href="/actividades">Actividades</a>
      <a href="/contacto">Contacto</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0f172a;
    color: #f8fafc;
    padding: 2.5rem 1.5rem;
    margin-top: 4rem;
    border-top: 1px solid #1e293b;
  }
  .footer-container {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .footer-title { font-weight: 700; font-size: 1rem; color: #ffffff; margin-bottom: 0.4rem; }
  .footer-loc { color: #cbd5e1; font-size: 0.86rem; margin-top: 0.2rem; }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-links a {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.88rem;
  }
  .footer-links a:hover { color: #38bdf8; text-decoration: underline; }
</style>
