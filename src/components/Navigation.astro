---
const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Inicio" },
  { href: "/investigacion", label: "Investigación" },
  { href: "/personas", label: "Personas" },
  { href: "/formacion", label: "Formación" },
  { href: "/software", label: "Software" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/publicaciones", label: "Publicaciones" },
  { href: "/actividades", label: "Actividades" },
  { href: "/contacto", label: "Contacto" },
];
---
<div class="nav-wrapper">
  <button class="menu-toggle" aria-expanded="false" aria-controls="primary-navigation" aria-label="Abrir menú de navegación">
    <span class="hamburger"></span>
    <span class="menu-text">Menú</span>
  </button>

  <nav id="primary-navigation" class="nav-links" aria-label="Navegación principal">
    {links.map((link) => {
      const isActive = link.href === "/" ? pathname === "/" : pathname.startsWith(link.href);
      return (
        <a href={link.href} class={isActive ? "active" : ""}>
          {link.label}
        </a>
      );
    })}
  </nav>
</div>

<script>
  const btn = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#primary-navigation');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('open');
    });
  }
</script>

<style>
  .nav-wrapper { display: flex; align-items: center; }
  .menu-toggle {
    display: none;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 0.45rem 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    align-items: center;
    gap: 0.5rem;
  }
  .hamburger {
    width: 18px;
    height: 2px;
    background: #0f172a;
    position: relative;
    display: inline-block;
  }
  .hamburger::before, .hamburger::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background: #0f172a;
  }
  .hamburger::before { top: -5px; }
  .hamburger::after { top: 5px; }
  .nav-links {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .nav-links a {
    text-decoration: none;
    color: #334155;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.45rem 0.7rem;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }
  .nav-links a:hover, .nav-links a:focus-visible {
    background: #f1f5f9;
    color: #0284c7;
    outline: 2px solid transparent;
  }
  .nav-links a.active {
    background: #e0f2fe;
    color: #0369a1;
  }
  @media (max-width: 960px) {
    .menu-toggle { display: inline-flex; }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      padding: 1rem 1.5rem;
      flex-direction: column;
      align-items: stretch;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
    }
    .nav-links.open { display: flex; }
    .nav-links a { padding: 0.65rem 0.85rem; }
  }
</style>
